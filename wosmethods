install.packages("bibliometrix")
library(bibliometrix)

# 1. Instalar librerías si no las tienes (quita el '#' para instalar)
install.packages(c("readxl", "writexl", "dplyr", "stringr", "tidyr", "ggplot2"))

# 1. Cargar librerías
library(readxl)
library(dplyr)
library(stringr)
library(ggplot2)

# 2. Cargar tus archivos Excel
wos_excel <- read_excel("savedrecs.xlsx")
mi_excel  <- read_excel("Data Extraction (ThinkNeuro) (1).xlsx")

# 3. Calcular automáticamente los conteos desde tus datos
n_preliminar <- nrow(wos_excel)

# Asegurar los 100 estudios elegibles (ordenados por citas)
top100 <- mi_excel %>%
  mutate(`WoS Core` = as.numeric(`WoS Core`)) %>%
  arrange(desc(`WoS Core`)) %>%
  slice_head(n = 100)

n_elegibles    <- nrow(top100)
n_no_elegibles <- n_preliminar - n_elegibles

# Cruzar con savedrecs.xlsx para contar cuántos son Articles y cuántos son Review
col_titulo  <- intersect(names(wos_excel), c("Article Title", "TI"))[1]
col_doctype <- intersect(names(wos_excel), c("Document Type", "DT"))[1]

wos_tipos <- wos_excel %>%
  mutate(
    TI_clean = str_remove_all(toupper(trimws(.data[[col_titulo]])), "[[:punct:]]"),
    Tipo = ifelse(str_detect(toupper(.data[[col_doctype]]), "REVIEW"), "Review", "Article")
  ) %>%
  select(TI_clean, Tipo) %>%
  distinct(TI_clean, .keep_all = TRUE)

conteo_tipos <- top100 %>%
  mutate(TI_clean = str_remove_all(toupper(trimws(`Article title`)), "[[:punct:]]")) %>%
  left_join(wos_tipos, by = "TI_clean") %>%
  count(Tipo)

n_articles <- conteo_tipos$n[conteo_tipos$Tipo == "Article"]
n_reviews  <- conteo_tipos$n[conteo_tipos$Tipo == "Review"]

# Si algún valor queda vacío, asignar 0 para evitar errores
if (length(n_articles) == 0) n_articles <- 0
if (length(n_reviews) == 0)  n_reviews  <- 0

# Imprimir resumen en consola para verificación
cat("Preliminar:", n_preliminar, "| Elegibles:", n_elegibles, "| No elegibles:", n_no_elegibles, "\n")
cat("Articles:", n_articles, "| Review:", n_reviews, "\n")

# 4. Definir las cajas (nodos) del diagrama con las proporciones de la imagen
cajas <- data.frame(
  xmin = c(1.5, 1.5, 1.5, 5.2, 1.5, 1.5),
  xmax = c(8.5, 8.5, 4.8, 8.5, 4.0, 4.0),
  ymin = c(8.6, 6.4, 3.8, 3.8, 2.3, 0.9),
  ymax = c(9.8, 7.4, 5.2, 5.2, 3.2, 1.8),
  texto = c(
    "Web of Science Search",
    paste0("Preliminary Search Results (n=", n_preliminar, ")"),
    paste0("Eligible Study\n(n =", n_elegibles, ")"),
    paste0("Non-eligible Study\n(n=", n_no_elegibles, ")"),
    paste0("Articles = ", n_articles),
    paste0("Review = ", n_reviews)
  ),
  tamano_letra = c(6.5, 4.8, 4.5, 4.5, 4.3, 4.3)
)

# 5. Definir las líneas conectoras y flechas
lineas <- data.frame(
  x    = c(5.0, 3.15, 3.15, 6.85, 4.4, 4.4, 4.4),
  xend = c(5.0, 6.85, 3.15, 6.85, 4.4, 4.0, 4.0),
  y    = c(6.4, 5.9,  5.9,  5.9,  3.8, 2.75, 1.35),
  yend = c(5.9, 5.9,  5.2,  5.2,  1.35, 2.75, 1.35),
  flecha = c(FALSE, FALSE, TRUE, TRUE, FALSE, TRUE, TRUE)
)

# 6. Dibujar el diagrama de flujo con ggplot2
figura_flujo <- ggplot() +
  # Cajas azul claro con borde negro
  geom_rect(
    data = cajas,
    aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax),
    fill = "#d9e2f3", color = "black", linewidth = 0.6
  ) +
  # Texto en negrita dentro de cada caja
  geom_text(
    data = cajas,
    aes(x = (xmin + xmax) / 2, y = (ymin + ymax) / 2, label = texto, size = tamano_letra),
    fontface = "bold", family = "serif", color = "black"
  ) +
  scale_size_identity() +
  # Flecha principal superior
  geom_segment(
    aes(x = 5.0, xend = 5.0, y = 8.6, yend = 7.4),
    arrow = arrow(length = unit(0.22, "cm"), type = "closed"),
    linewidth = 0.6, color = "black"
  ) +
  # Líneas sin flecha
  geom_segment(
    data = filter(lineas, !flecha),
    aes(x = x, xend = xend, y = y, yend = yend),
    linewidth = 0.6, color = "black"
  ) +
  # Líneas con flecha
  geom_segment(
    data = filter(lineas, flecha),
    aes(x = x, xend = xend, y = y, yend = yend),
    arrow = arrow(length = unit(0.20, "cm"), type = "closed"),
    linewidth = 0.6, color = "black"
  ) +
  coord_cartesian(xlim = c(1, 9), ylim = c(0.5, 10.2)) +
  theme_void() +
  theme(plot.background = element_rect(fill = "white", color = NA))

# 7. Mostrar en pantalla y guardar en alta resolución (300 dpi)
print(figura_flujo)

ggsave(
  filename = "Figure_4_WoS_Method_Flowchart.png",
  plot = figura_flujo,
  width = 8,
  height = 6.5,
  dpi = 300,
  bg = "white"
)


