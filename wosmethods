# 1. Instalar librerías si no las tienes (quita el '#' para instalar)
install.packages(c("readxl", "writexl", "dplyr", "stringr", "tidyr", "ggplot2"))

# 1. Cargar librerías
library(readxl)
library(writexl)
library(dplyr)
library(stringr)
library(ggplot2)

# 2. Cargar tus dos archivos (.xlsx)
wos_excel <- read_excel("savedrecs.xlsx")
mi_excel  <- read_excel("Data Extraction (ThinkNeuro) (1).xlsx")

# Identificar columnas clave en savedrecs.xlsx
col_titulo   <- intersect(names(wos_excel), c("Article Title", "TI"))[1]
col_abstract <- intersect(names(wos_excel), c("Abstract", "AB"))[1]
col_keywords <- intersect(names(wos_excel), c("Author Keywords", "DE"))[1]
col_doctype  <- intersect(names(wos_excel), c("Document Type", "DT"))[1]

# 3. Clasificar la metodología de cada estudio leyendo Título, Abstract y Keywords
wos_metodos <- wos_excel %>%
  rename(
    TI_temp = all_of(col_titulo),
    AB_temp = all_of(col_abstract),
    DE_temp = all_of(col_keywords),
    DT_temp = all_of(col_doctype)
  ) %>%
  mutate(
    # Unir todo el texto disponible del artículo en mayúsculas para buscar términos metodológicos
    texto_completo = toupper(paste(TI_temp, AB_temp, DE_temp, sep = " ")),
    TI_clean = str_remove_all(toupper(trimws(TI_temp)), "[[:punct:]]"),
    
    # Clasificación metodológica basada en palabras clave de neurociencia
    Metodo_Principal = case_when(
      str_detect(toupper(DT_temp), "REVIEW") ~ "Review / Theoretical",
      str_detect(texto_completo, "FMRI|FUNCTIONAL MAGNETIC|NEUROIMAGING|PET |POSITRON EMISSION|EEG|MEG ") ~ "Human Neuroimaging (fMRI/PET/EEG)",
      str_detect(texto_completo, "OPTOGENETIC|ELECTROPHYSIOL|SINGLE-UNIT|VOLTAMMETRY|MICRODIALYSIS|RODENT|RAT |RATS |MOUSE|MICE|MONKEY|PRIMATE|ANIMAL") ~ "Animal / Electrophysiology",
      str_detect(texto_completo, "GENETIC|GENE|POLYMORPHISM|COMT|DRD2|DAT1|PARKINSON|PHARMACOL|L-DOPA|LEVODOPA|MEDICATION|PATIENT") ~ "Clinical / Genetics / Pharmacology",
      str_detect(texto_completo, "COMPUTATIONAL|MODEL|SIMULATION|REINFORCEMENT LEARNING|TEMPORAL DIFFERENCE|ACTOR-CRITIC|BAYESIAN|NETWORK") ~ "Computational Modeling",
      TRUE ~ "Behavioral / Other"
    )
  ) %>%
  select(TI_clean, Document_Type = DT_temp, Metodo_Principal) %>%
  distinct(TI_clean, .keep_all = TRUE)

# 4. Cruzar los métodos con tu Excel del Top 100
excel_con_metodos <- mi_excel %>%
  mutate(TI_clean = str_remove_all(toupper(trimws(`Article title`)), "[[:punct:]]")) %>%
  left_join(wos_metodos, by = "TI_clean") %>%
  select(-TI_clean)

# Guardar el Excel actualizado para revisión
write_xlsx(excel_con_metodos, "Data Extraction (ThinkNeuro)_Con_Metodos.xlsx")

# 5. Agrupar datos para la figura de Enfoques Metodológicos
resumen_metodos <- excel_con_metodos %>%
  mutate(`WoS Core` = as.numeric(`WoS Core`)) %>%
  filter(!is.na(Metodo_Principal)) %>%
  group_by(Metodo_Principal) %>%
  summarise(
    Articulos = n(),
    Citas_Totales = sum(`WoS Core`, na.rm = TRUE)
  ) %>%
  arrange(desc(Articulos), desc(Citas_Totales))

# Ver tabla en consola
print(resumen_metodos)

# 6. Generar la figura de Métodos (Web of Science Method Figure)
grafico_metodos <- ggplot(resumen_metodos, aes(x = reorder(Metodo_Principal, Articulos), y = Articulos)) +
  geom_col(fill = "#4a6fe3", width = 0.65) +
  geom_text(
    aes(label = paste0(Articulos, " (", Citas_Totales, " citations)")), 
    hjust = -0.1, 
    size = 3.5, 
    color = "black"
  ) +
  coord_flip() +
  scale_y_continuous(
    expand = expansion(mult = c(0, 0.32)), 
    breaks = seq(0, max(resumen_metodos$Articulos) + 5, by = 5)
  ) +
  labs(
    title = "Methodological Approaches in the Top 100 Most Cited Papers",
    subtitle = "Categorized from Web of Science metadata (Abstract, Keywords, and Document Type)",
    x = "Study Design / Method",
    y = "Number of Papers in Top 100"
  ) +
  theme_minimal(base_size = 12) +
  theme(
    panel.grid.major.y = element_blank(),
    panel.grid.minor = element_blank(),
    plot.title = element_text(face = "bold", size = 13),
    axis.text.y = element_text(face = "bold", color = "black", size = 10)
  )

# Visualizar y guardar en alta resolución (300 dpi)
print(grafico_metodos)

ggsave(
  filename = "WoS_Methods_Top100.png", 
  plot = grafico_metodos, 
  width = 10.5, 
  height = 5.5, 
  dpi = 300,
  bg = "white"
)

